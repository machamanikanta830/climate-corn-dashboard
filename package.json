{
  "name": "climate-corn-dashboard",
  "version": "1.0.0",
  "description": "Interactive exploration of climate patterns and U.S. corn yield from 2000 to 2024.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean_build.mjs && vite build && node scripts/prepare_sites_build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:data": "python3 scripts/validate_dataset.py",
    "check": "npm run validate:data && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.7"
  }
}
